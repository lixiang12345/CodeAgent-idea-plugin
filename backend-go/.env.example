# augment-local — 自托管 Augment 后端环境变量
# 全部可选；不设置即用默认值。

# 监听地址
OIDC_ADDR=:8445
TENANT_ADDR=:8787

# 插件侧可达的地址（IDE 所在机器）
OIDC_URL=http://127.0.0.1:8445
TENANT_URL=http://127.0.0.1:8787

# 租户/用户身份（写进 JWT claims）
TENANT_ID=local-tenant
TENANT_NAME=Augment Local
USER_ID=local-user
USER_EMAIL=local@augment.local
USER_NAME=Local User
USER_PLAN=professional

# 真实模型网关（可选）：OpenAI 兼容 /chat/completions，开启后 chat-stream
# 的最终文本走该网关，否则用内置模拟器回复。
# MODEL_GATEWAY_URL=https://gateway.example.com/v1/chat/completions

# 网关 API 密钥（可选，未设置时走模拟器）：不要写进 git 追踪的文件。
# 复制本文件为 .env（gitignored）后填写：
# MODEL_GATEWAY_API_KEY=sk-...     （OpenAI 兼容网关的 Bearer token）

# 固定 JWT 签名密钥（可选）：PKCS#8 "PRIVATE KEY" PEM 单行（\n 转义）。
# 不设置则每次启动生成临时密钥（JWKS 同源返回，不影响使用）。
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
