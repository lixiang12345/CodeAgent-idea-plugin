HOST=127.0.0.1
PORT=8787
CODEAGENT_AUTH_TOKEN=replace-with-a-long-random-token
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
MODEL_BASE_URL=https://gateway.example.com
MODEL_API_KEY=replace-with-the-unified-gateway-key

# GET MODEL_BASE_URL/v1/models must return protocol metadata for every model:
# openai-responses, anthropic-messages, or xai-responses.

# Alternatively, configure a fixed multi-provider allowlist. Each enabled provider
# must define its own Base URL, API key, and comma-separated model IDs.
# MODEL=gpt-5.6-sol
# CONTEXT_QUERY_MODEL=gpt-5.4-mini
# MODEL_MAX_OUTPUT_TOKENS=8192
# MODEL_STREAM_IDLE_TIMEOUT_MS=45000
# OPENAI_BASE_URL=https://gateway.example.com
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5.6-sol
# OPENAI_INTERNAL_MODELS=gpt-5.4-mini
# GROK_BASE_URL=https://gateway.example.com
# GROK_API_KEY=
# GROK_MODELS=grok-4.5
# ANTHROPIC_BASE_URL=https://gateway.example.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-fable-5,claude-sonnet-5

# Public product infrastructure. Use production secrets and HTTPS outside local development.
DATABASE_URL=postgresql://codeagent:codeagent-local@127.0.0.1:5432/codeagent
DATABASE_SSL=false
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=codeagent-backend
OIDC_CLIENT_SECRET=replace-with-the-oidc-client-secret
OIDC_AUDIENCE=codeagent-api
PUBLIC_BASE_URL=http://127.0.0.1:8788
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters
# Managed Node runtime distribution. Use one source: inline JSON for small/private deployments,
# or an HTTPS URL that serves the same manifest schema for multi-platform releases.
# RUNTIME_MANIFEST_JSON={"version":1,"runtimes":[]}
RUNTIME_MANIFEST_URL=https://downloads.example.com/codeagent/runtime-manifest.json

# Deployment-owned cloud surfaces. Every variable below is optional; an unset
# group is reported as explicitly unavailable, never as a fabricated value.
#
# Shareable read-only session links. While SHARE_BASE_URL is unset, every
# /v1/conversations/{id}/share request answers 503 "Shareable links are not
# configured on this deployment". Absolute https (loopback http for local
# development), no credentials, query, or fragment; trailing slashes are
# stripped. The public link is SHARE_BASE_URL/v1/share/<token>; only the token's
# SHA-256 hash is stored, so the plaintext link exists once, in the creating
# response. SHARE_LINK_TTL_SECONDS is the default link lifetime in seconds
# (60-31536000, default 604800); each request may pass its own ttlSeconds.
# SHARE_BASE_URL=https://codeagent.example.com
# SHARE_LINK_TTL_SECONDS=604800
#
# Operator-published notifications returned by GET /v1/notifications. Unset
# means an empty catalog, and an empty list is a healthy response, not an error.
# At most 20 entries; each entry: unique id (1-120 of [A-Za-z0-9._-]), level
# info|warning|error (default info), message (<=2000 chars), optional
# actionItems (max 4, <=80-char title, https URL), optional expiresAt (epoch ms
# or ISO string), optional userIds audience (max 200). Dismissals are stored per
# user; dismissed, expired, and out-of-audience entries never reach a client.
# NOTIFICATIONS_JSON=[{"id":"maintenance-2026-08-02","level":"warning","message":"Scheduled backend maintenance on 2026-08-02, 01:00-03:00 UTC. Agent runs may be interrupted.","actionItems":[{"title":"Maintenance notice","url":"https://status.example.com/codeagent/maintenance"}],"expiresAt":"2026-08-02T03:00:00Z"},{"id":"model-catalog-refresh","message":"Two new models are available in the model picker."}]
#
# Subscription plans and quotas for the `subscription` object of GET /v1/me.
# Quotas are compared against usage the backend actually counted. With
# SUBSCRIPTION_PLANS_JSON unset, the account carrying no plan, an unknown plan,
# or a plan without quotas, the response is state "unknown" plus a `reason`
# string and no warning. Each plan may declare a label (<=80 chars), an https
# manageUrl, and up to 20 non-negative integer quotas; at most 20 plans.
# SUBSCRIPTION_PLAN_CLAIM names the principal claim carrying the plan ID
# (default codeagent_plan); SUBSCRIPTION_DEFAULT_PLAN applies when the claim is
# absent and must exist in SUBSCRIPTION_PLANS_JSON. SUBSCRIPTION_WARN_RATIO
# (0.5-0.99, default 0.8) is the used/limit ratio at which a quota becomes
# "approaching"; reaching the limit makes it "exhausted".
# SUBSCRIPTION_PLANS_JSON={"free":{"label":"Free","manageUrl":"https://billing.example.com/codeagent","quotas":{"agent_runs":100}},"team":{"label":"Team","manageUrl":"https://billing.example.com/codeagent","quotas":{"agent_runs":5000,"model_tokens":50000000}}}
# SUBSCRIPTION_PLAN_CLAIM=codeagent_plan
# SUBSCRIPTION_DEFAULT_PLAN=free
# SUBSCRIPTION_WARN_RATIO=0.8

# Web search: choose Brave or a compatible custom POST endpoint.
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
#
# Custom endpoint contract:
#   POST WEB_SEARCH_ENDPOINT
#   Authorization: Bearer WEB_SEARCH_API_KEY (optional)
#   body: {"query":"...","limit":5}
#   response: {"results":[{"title":"...","url":"...","snippet":"..."}]}
# WEB_SEARCH_PROVIDER=custom
# WEB_SEARCH_ENDPOINT=
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_API_KEY_HEADER=Authorization

# SaaS integration adapters
# GitHub reads need repository Metadata, Issues, Pull requests, Contents, Checks, and Actions read access.
# Branch-protection and repository-ruleset reads can require Administration read access.
# github_manage needs Issues or Pull requests write access for issue/PR creation, comments,
# reviews, line comments, and reviewer requests. github_actions_manage needs Actions write access.
# github_merge_pull_request needs Pull requests write access. Every write tool is approval-gated;
# merge also requires the exact approved PR head SHA and a fresh branch-policy readiness audit.
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
#
# LINEAR_API_KEY=
# LINEAR_API_URL=https://api.linear.app/graphql
#
# NOTION_TOKEN=
# NOTION_API_URL=https://api.notion.com/v1
# NOTION_VERSION=2025-09-03
#
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_BEARER_TOKEN=
#
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_BEARER_TOKEN=
#
# GLEAN_SEARCH_ENDPOINT=https://your-instance/rest/api/v1/search
# GLEAN_API_TOKEN=
#
# Supabase queries are GET-only and restricted to this table/view allowlist.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=
# SUPABASE_TABLES=issues,projects
# SUPABASE_SCHEMA=public
